<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds against the package in ../artifacts. Run test.sh / test.ps1 from the repository root. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).packages</RestorePackagesPath>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)../artifacts</RestoreAdditionalProjectSources>
    <HumbattPackageVersion Condition="'$(HumbattPackageVersion)' == ''">*</HumbattPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Humbatt.MSBuild.Obfuscar" Version="$(HumbattPackageVersion)" />
  </ItemGroup>

</Project>
