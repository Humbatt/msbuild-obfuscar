<Project Sdk="Microsoft.NET.Sdk">

  <!-- Packs the MSBuild targets with Obfuscar's cross-platform console. No code of its own. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Keep in step with HumbattObfuscarVersion in build/Humbatt.MSBuild.Obfuscar.targets. -->
    <ObfuscarVersion>2.2.50</ObfuscarVersion>
    <Version>$(ObfuscarVersion).1</Version>
    <PackageId>Humbatt.MSBuild.Obfuscar</PackageId>
    <Title>Humbatt.MSBuild.Obfuscar</Title>
    <Authors>Enner Pérez, Humbatt</Authors>
    <Description>MSBuild targets that run Obfuscar after Release builds, on Windows, Linux and macOS.</Description>
    <PackageTags>Obfuscar MSBuild Targets obfuscation</PackageTags>
    <PackageProjectUrl>https://github.com/Humbatt/msbuild-obfuscar</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Humbatt/msbuild-obfuscar</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageReleaseNotes>Works on Linux and macOS: runs Obfuscar's cross-platform console (bundled, Obfuscar $(ObfuscarVersion)) with the build's .NET host, finds the Obfuscar package in lower-case NuGet folders, and replaces the output with the obfuscated files on every OS. Set ObfuscarRunner=exe for the previous Obfuscar.Console.exe behaviour, SkipObfuscation=true to turn it off.</PackageReleaseNotes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../artifacts</PackageOutputPath>
    <!-- Nothing in lib/: a targets-only package. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Obfuscar.Console.exe for ObfuscarRunner=exe. Obfuscar is a development dependency, so make it flow. -->
    <PackageReference Include="Obfuscar" Version="$(ObfuscarVersion)" PrivateAssets="none" />
    <!-- The cross-platform console, bundled because a dotnet-tool package cannot be a dependency. -->
    <PackageDownload Include="Obfuscar.GlobalTool" Version="[$(ObfuscarVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/**" Pack="true" PackagePath="build/" />
    <None Include="content/**" Pack="true" PackagePath="content/" />
    <None Include="$(NuGetPackageRoot)obfuscar.globaltool/$(ObfuscarVersion)/tools/net10.0/any/**" Exclude="$(NuGetPackageRoot)obfuscar.globaltool/$(ObfuscarVersion)/tools/net10.0/any/DotnetToolSettings.xml" Pack="true" PackagePath="tools/net/" Visible="false" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
    <None Include="../.editoricon.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

</Project>
