<?xml version="1.0" encoding="utf-8"?>
<!--
***********************************************************************************************
Humbatt.MSBuild.Obfuscar.targets

Runs Obfuscar after a Release build of a project that has a <ProjectName>.xml or Obfuscar.xml
configuration, then replaces the build output with the obfuscated files. Works on Windows,
Linux and macOS.

Settings (all optional):
  ObfuscarRunner          dotnet (default): the cross-platform Obfuscar console bundled in this
                          package, run with the .NET host that is running the build (.NET 10+).
                          exe: Obfuscar.Console.exe from the Obfuscar package (.NET Framework;
                          Windows, or elsewhere with Mono).
  SkipObfuscation         true to build without obfuscating.
  ObfuscarConfigFile      The Obfuscar configuration file to use.
                          Default: <ProjectName>.xml, else Obfuscar.xml, beside the project.
***********************************************************************************************
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- Keep in step with ObfuscarVersion in Humbatt.MSBuild.Obfuscar.csproj. -->
    <HumbattObfuscarVersion>2.2.50</HumbattObfuscarVersion>

    <ObfuscarRunner Condition="'$(ObfuscarRunner)' == ''">dotnet</ObfuscarRunner>

    <!-- dotnet runner: the bundled console, run by the build's own .NET host. -->
    <ObfuscarDotnetToolPath Condition="'$(ObfuscarDotnetToolPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'tools', 'net', 'GlobalTools.dll'))</ObfuscarDotnetToolPath>
    <ObfuscarDotnetHost Condition="'$(ObfuscarDotnetHost)' == ''">$(DOTNET_HOST_PATH)</ObfuscarDotnetHost>
    <ObfuscarDotnetHost Condition="'$(ObfuscarDotnetHost)' == ''">dotnet</ObfuscarDotnetHost>

    <!-- exe runner: Obfuscar.Console.exe from the Obfuscar package. NuGet's global packages folder
         uses lower-case ids, which matters on case-sensitive file systems. -->
    <ObfuscatorToolsPath Condition="'$(ObfuscatorToolsPath)' == '' And '$(NuGetPackageRoot)' != ''">$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)', 'obfuscar', '$(HumbattObfuscarVersion)', 'tools'))</ObfuscatorToolsPath>
    <ObfuscatorToolsPath Condition="'$(ObfuscatorToolsPath)' == '' Or !Exists('$(ObfuscatorToolsPath)')">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'Obfuscar.$(HumbattObfuscarVersion)', 'tools'))</ObfuscatorToolsPath>
    <ObfuscatorExePath Condition="'$(ObfuscatorExePath)' == ''">$([MSBuild]::NormalizePath('$(ObfuscatorToolsPath)', 'Obfuscar.Console.exe'))</ObfuscatorExePath>

    <ObfuscatorCommand Condition="'$(ObfuscatorCommand)' == '' And '$(ObfuscarRunner)' == 'dotnet'">"$(ObfuscarDotnetHost)" "$(ObfuscarDotnetToolPath)"</ObfuscatorCommand>
    <ObfuscatorCommand Condition="'$(ObfuscatorCommand)' == '' And '$(OS)' == 'Windows_NT'">"$(ObfuscatorExePath)"</ObfuscatorCommand>
    <ObfuscatorCommand Condition="'$(ObfuscatorCommand)' == ''">mono "$(ObfuscatorExePath)"</ObfuscatorCommand>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The configuration: <ProjectName>.xml, else Obfuscar.xml, next to the project file. -->
    <!-- Not ProjectFileName: that is MSBuild's own property (the project file's name), which earlier
         versions overwrote. -->
    <ObfuscarConfigFile Condition="'$(ObfuscarConfigFile)' == ''">$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(MSBuildProjectName).xml'))</ObfuscarConfigFile>
    <ObfuscarConfigFile Condition="!Exists('$(ObfuscarConfigFile)')">$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Obfuscar.xml'))</ObfuscarConfigFile>

    <ObfuscateCommand>$(ObfuscatorCommand) "$(ObfuscarConfigFile)"</ObfuscateCommand>
  </PropertyGroup>

  <Target Name="CheckPrerequisites">
    <Error Condition="'$(ObfuscarRunner)' == 'dotnet' And !Exists('$(ObfuscarDotnetToolPath)')" Text="Unable to locate the Obfuscar console '$(ObfuscarDotnetToolPath)'." />
    <Error Condition="'$(ObfuscarRunner)' != 'dotnet' And '$(DownloadObfuscatorExe)' != 'true' And !Exists('$(ObfuscatorExePath)')" Text="Unable to locate '$(ObfuscatorExePath)'." />
  </Target>

  <Target Name="Obfuscator" AfterTargets="AfterBuild" DependsOnTargets="CheckPrerequisites" Condition="Exists('$(ObfuscarConfigFile)') And '$(Configuration)' == 'Release' And '$(SkipObfuscation)' != 'true'">
    <MakeDir Directories="$(TargetDir)obfuscated" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="$(ObfuscateCommand)" />
    <ItemGroup>
      <FilesToMove Include="$(TargetDir)obfuscated/*.*" />
    </ItemGroup>
    <!-- Every OS: before 2.2.50 this only happened on Windows, so other platforms shipped unobfuscated files. -->
    <Move SourceFiles="@(FilesToMove)" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" />
    <RemoveDir Directories="$(TargetDir)obfuscated" />
  </Target>

</Project>
